          ['Coffee break', 500, 4, '7.00', '14,000.00'],
          ['Lunch', 500, 5, '12.00', '30,000.00'],
          ['Dinner', 500, 5, '15.00', '37,500.00'],
          ['Nations Party', 500, 1, '20.00', '10,000.00'],
