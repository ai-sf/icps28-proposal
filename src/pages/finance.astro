          ['Night at the Egyptian museum', 1, '10,000.00', '10,000.00'],
          ['Final party', 1, '10,000.00', '10,000.00'],
          ['Torino Magica', 1, '1,000.00', '1,000.00'],
        ]}
        foot={['Subtotal', '', '', '21,000.00']}
      />

      <h4>Communication</h4>
      <DataTable
        headers={['Description', 'Num. of Units', 'Price / Unit (€)', 'Total (€)']}
        rows={[
          ['T-Shirt/gadget', 500, '12.00', '6,000.00'],
          ['Badge, lanyard, communication', 500, '6.00', '3,000.00'],
          ['Speaker prizes', 15, '50.00', '750.00'],
          ['Participants prizes', 10, '50.00', '500.00'],
