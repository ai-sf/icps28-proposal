---
// DataTable — finance/visa/excursion tables with right-aligned numeric columns,
// optional footer totals row.
import { slugify } from '../ids';

interface Props {
  /** Column headers */
  headers: string[];
  /** Data rows (arrays of cells) */
  rows: (string | number)[][];
  /** Optional footer row(s), last column styled as total */
  foot?: (string | number)[];
  /** Caption shown above the table */
  caption?: string;
  /** Optional stable id for Open Design element targeting (defaults to a caption slug). */
  id?: string;
}

const { headers, rows, foot, caption, id } = Astro.props;
---

<figure data-od-id={id ?? (caption ? 'data-table-' + slugify(caption) : undefined)}>
  {caption && <figcaption class="data-caption">{caption}</figcaption>}
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          {headers.map((h) => <th scope="col">{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((cell) => <td>{cell}</td>)}          </tr>
        ))}
      </tbody>
      {foot && (
        <tfoot>
          <tr>
            {foot.map((cell, i) => <td class={i === foot.length - 1 ? 'total' : ''}>{cell}</td>)}
          </tr>
        </tfoot>
      )}
    </table>
  </div>
</figure>
