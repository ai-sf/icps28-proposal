---
// DataTable — finance/visa/excursion tables with right-aligned numeric columns,
// optional footer totals row.
interface Props {
  /** Column headers */
  headers: string[];
  /** Data rows (arrays of cells) */
  rows: (string | number)[][];
  /** Optional footer row(s), last column styled as total */
  foot?: (string | number)[];
  /** If true, first column is left-aligned (default true) */
  firstLeft?: boolean;
  /** Caption shown above the table */
  caption?: string;
}

const { headers, rows, foot, firstLeft = true, caption } = Astro.props;
---

<figure>
  {caption && <figcaption style="font-style:normal;font-family:var(--font-display);letter-spacing:.06em;text-transform:uppercase;font-size:var(--text-xs);font-weight:650;color:var(--muted);margin-bottom:.5rem">{caption}</figcaption>}
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          {headers.map((h) => <th scope="col">{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((cell, i) => <td data-left={firstLeft && i === 0 ? true : undefined}>{cell}</td>)}
          </tr>
        ))}
      </tbody>
      {foot && (
        <tfoot>
          <tr>
            {foot.map((cell, i) => <td class={i === foot.length - 1 ? 'total' : ''}>{cell}</td>)}
          </tr>
        </tfoot>
      )}
    </table>
  </div>
</figure>
